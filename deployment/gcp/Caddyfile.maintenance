# ============================================================
# TravelCRM Oracle VM Caddy Configuration - MAINTENANCE MODE
# ============================================================

{
    email support@imagicaholidays.com
}

# --- CRM Frontend (MAINTENANCE MODE ACTIVE) ---
crm.imagicaholidays.com {
    handle /webhook/* {
        reverse_proxy backend:3001
    }
    handle /v1/webhook/* {
        reverse_proxy backend:3001
    }
    handle /api/v1/webhook/* {
        reverse_proxy backend:3001
    }
    handle {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "no-store, no-cache, must-revalidate"
        respond `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Under Maintenance — Imagica Holidays CRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #090d16;
      color: #f8fafc;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow-x: hidden;
      position: relative;
    }
    body::before {
      content: '';
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.08) 0%, rgba(15, 23, 42, 0) 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 0;
    }
    .card {
      position: relative;
      z-index: 1;
      max-width: 580px;
      width: 100%;
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 24px;
      padding: 44px 36px;
      text-align: center;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.04);
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.25);
      border-radius: 9999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fbbf24;
      margin-bottom: 24px;
    }
    .pulse-dot {
      width: 7px;
      height: 7px;
      background: #f59e0b;
      border-radius: 50%;
      box-shadow: 0 0 10px #f59e0b;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.3); opacity: 1; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .icon-container {
      width: 76px;
      height: 76px;
      margin: 0 auto 24px;
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(245, 158, 11, 0.15) 100%);
      border: 1px solid rgba(245, 158, 11, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .icon-container svg {
      width: 38px;
      height: 38px;
      color: #fbbf24;
    }
    h1 {
      font-size: 26px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
      line-height: 1.25;
    }
    .warning-box {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.35);
      border-radius: 12px;
      padding: 14px 18px;
      margin: 20px 0 24px;
      color: #fca5a5;
      font-size: 14.5px;
      font-weight: 700;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    p.desc {
      color: #94a3b8;
      font-size: 13.5px;
      line-height: 1.65;
      margin-bottom: 24px;
      font-weight: 400;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 16px;
      background: rgba(2, 6, 23, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
      margin-bottom: 24px;
      text-align: left;
    }
    .info-item {
      font-size: 11px;
    }
    .info-label {
      color: #64748b;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 3px;
    }
    .info-val {
      color: #e2e8f0;
      font-weight: 600;
    }
    .footer {
      font-size: 11.5px;
      color: #475569;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 20px;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="brand">
      <span class="pulse-dot"></span>
      <span>Imagica Holidays • Internal CRM</span>
    </div>
    
    <div class="icon-container">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.32l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.32 4.486c.049.58.025 1.193-.14 1.743" />
      </svg>
    </div>

    <h1>System Under Maintenance</h1>
    
    <div class="warning-box">
      <span>⛔</span>
      <span>This is under maintenance. Don't try to open this.</span>
    </div>

    <p class="desc">
      Our engineering team is currently performing scheduled system updates and database maintenance. Access for all team members and administrators is temporarily suspended for the next 24 to 48 hours.
    </p>

    <div class="info-grid">
      <div class="info-item">
        <div class="info-label">Current Status</div>
        <div class="info-val" style="color: #fbbf24;">Maintenance Active</div>
      </div>
      <div class="info-item">
        <div class="info-label">Expected Duration</div>
        <div class="info-val">24 – 48 Hours</div>
      </div>
      <div class="info-item">
        <div class="info-label">Authorized Access</div>
        <div class="info-val" style="color: #f87171;">Strictly Locked</div>
      </div>
      <div class="info-item">
        <div class="info-label">Concierge Desk</div>
        <div class="info-val">+91 62914 26647</div>
      </div>
    </div>

    <div class="footer">
      Imagica Holidays Travel Portal • Controlled by System Administrator
    </div>
  </div>
</body>
</html>` 503
    }
}

# --- CRM Backend API ---
api.imagicaholidays.com {
    reverse_proxy backend:3001
}

# --- MinIO S3 API & Console ---
s3.imagicaholidays.com {
    reverse_proxy minio:9000
}

minio.imagicaholidays.com {
    reverse_proxy minio:9001
}

# --- n8n Workflow Automation ---
n8n.imagicaholidays.com {
    reverse_proxy n8n:5678
}
