# ============================================================
# TravelCRM Oracle VM Caddy Configuration - MAINTENANCE MODE
# ============================================================

{
    email support@imagicaholidays.com
}

# --- CRM Frontend (MAINTENANCE MODE ACTIVE) ---
crm.imagicaholidays.com {
    handle /webhook/* {
        reverse_proxy backend:3001
    }
    handle /v1/webhook/* {
        reverse_proxy backend:3001
    }
    handle /api/v1/webhook/* {
        reverse_proxy backend:3001
    }
    handle {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "no-store, no-cache, must-revalidate"
        respond `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Under Maintenance — Imagica Holidays CRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background-color: #07090e;
      color: #f8fafc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 36px 24px;
      overflow-x: hidden;
      position: relative;
    }
    .bg-layer {
      position: absolute;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=2000&auto=format&fit=crop');
      background-size: cover;
      background-position: center;
      filter: brightness(0.24) contrast(1.15) saturate(0.85);
      z-index: 0;
    }
    .vignette {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(7, 9, 14, 0.6) 0%, rgba(7, 9, 14, 0.95) 80%);
      z-index: 1;
    }
    .container {
      position: relative;
      z-index: 2;
      max-width: 640px;
      width: 100%;
      margin: auto;
      text-align: center;
      padding: 20px;
    }
    .brand-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 16px;
      background: rgba(197, 168, 128, 0.08);
      border: 1px solid rgba(197, 168, 128, 0.3);
      border-radius: 9999px;
      margin-bottom: 28px;
    }
    .pulse-dot {
      width: 6px;
      height: 6px;
      background: #c5a880;
      border-radius: 50%;
      box-shadow: 0 0 10px #c5a880;
      animation: pulse 2.2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.6; transform: scale(0.9); }
      50% { opacity: 1; transform: scale(1.3); }
    }
    .brand-title {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: #e5c9a3;
    }
    h1 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 44px;
      font-weight: 500;
      line-height: 1.15;
      color: #fdfbf7;
      letter-spacing: -0.01em;
      margin-bottom: 8px;
    }
    .subtitle {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 22px;
      font-style: italic;
      color: #c5a880;
      margin-bottom: 24px;
    }
    .divider {
      width: 48px;
      height: 1px;
      background: linear-gradient(90deg, transparent, #c5a880, transparent);
      margin: 0 auto 28px;
    }
    .notice-card {
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(239, 68, 68, 0.35);
      border-radius: 14px;
      padding: 16px 22px;
      margin-bottom: 24px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.5);
    }
    .notice-text {
      color: #fca5a5;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    p.description {
      color: #94a3b8;
      font-size: 14px;
      line-height: 1.7;
      margin-bottom: 32px;
      font-weight: 300;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }
    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 26px;
      border-radius: 9999px;
      background: linear-gradient(135deg, #c5a880 0%, #b39369 100%);
      color: #07090e;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 10px 25px -8px rgba(197, 168, 128, 0.4);
    }
    .btn-gold:hover {
      background: linear-gradient(135deg, #d4b78f 0%, #c5a880 100%);
      transform: translateY(-1px);
    }
    .btn-glass {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #cbd5e1;
      font-size: 12px;
      text-decoration: none;
      backdrop-filter: blur(12px);
      transition: all 0.3s ease;
    }
    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.25);
      color: #fff;
    }
    footer {
      position: relative;
      z-index: 2;
      text-align: center;
      font-size: 11px;
      color: #475569;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
  </style>
</head>
<body>
  <div class="bg-layer"></div>
  <div class="vignette"></div>

  <div></div>

  <div class="container">
    <div class="brand-pill">
      <span class="pulse-dot"></span>
      <span class="brand-title">Imagica Holidays • Internal Operations</span>
    </div>

    <h1>System Under Maintenance</h1>
    <div class="subtitle">Private Operations Temporarily Paused</div>

    <div class="divider"></div>

    <div class="notice-card">
      <span style="font-size: 16px;">⛔</span>
      <span class="notice-text">This is under maintenance. Don't try to open this.</span>
    </div>

    <p class="description">
      Our engineering team is currently performing scheduled infrastructure and database maintenance. Access is temporarily suspended for all team members and administrators for the next 24 to 48 hours.
    </p>

    <div class="actions">
      <a href="https://wa.me/916291426647" target="_blank" rel="noopener noreferrer" class="btn-gold">
        Emergency Concierge (+91 62914 26647)
      </a>
      <a href="mailto:support@imagicaholidays.com" class="btn-glass">
        support@imagicaholidays.com
      </a>
    </div>
  </div>

  <footer>
    Imagica Holidays Travel Portal • Controlled by System Administrator
  </footer>
</body>
</html>` 503
    }
}

# --- CRM Backend API ---
api.imagicaholidays.com {
    reverse_proxy backend:3001
}

# --- MinIO S3 API & Console ---
s3.imagicaholidays.com {
    reverse_proxy minio:9000
}

minio.imagicaholidays.com {
    reverse_proxy minio:9001
}

# --- n8n Workflow Automation ---
n8n.imagicaholidays.com {
    reverse_proxy n8n:5678
}
