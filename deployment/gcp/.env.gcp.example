# ============================================================
# TravelCRM GCP Deployment — Environment Variables Template
# ============================================================
# Copy this file as .env inside the same directory as docker-compose.yml 
# and fill in your actual production values.
# NEVER commit the real .env file to source control.
# ============================================================

# --- Database ---
DB_PASSWORD="your_strong_postgres_password"
DATABASE_URL="postgresql://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- JWT Authentication ---
JWT_SECRET="CHANGE_ME_TO_A_STRONG_64_CHAR_RANDOM_STRING"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_STRING"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- Server Host Settings ---
FRONTEND_URL="https://crm.imagicaholidays.com"
API_URL="https://api.imagicaholidays.com/api/v1"

# --- Email (SMTP via Brevo) ---
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-smtp-email@smtp-brevo.com"
SMTP_PASS="your-brevo-smtp-password"
EMAIL_FROM="noreply@imagicaholidays.com"
EMAIL_FROM_NAME="Imagica Holidays"
# Admin alert emails (separate sender identity)
ADMIN_EMAIL_FROM="administrative@imagicaholidays.com"
ADMIN_EMAIL_FROM_NAME="Imagica Holidays (Admin)"
# Brevo aliases (some code references these directly)
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="your-smtp-email@smtp-brevo.com"
BREVO_SMTP_PASS="your-brevo-smtp-password"
# Comma-separated emails that are never deleted from system
IMMORTAL_EMAILS="admin@imagicaholidays.com, harshbuddy01@gmail.com"

# --- Meilisearch (Instant Search) ---
# In Docker, the host must be internal: http://meilisearch:7700
# MEILI_MASTER_KEY is used by the meilisearch container itself
MEILISEARCH_MASTER_KEY="your_secure_meilisearch_master_key"
MEILISEARCH_HOST="http://meilisearch:7700"

# --- Safety Vault (DB Backups → stored in Cloudflare R2) ---
# Uses the same R2 credentials as image uploads (same bucket, different folders)
VAULT_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
VAULT_ACCESS_KEY="your_cloudflare_r2_access_key_id"
VAULT_SECRET_KEY="your_cloudflare_r2_secret_access_key"
VAULT_BUCKET="crm-backups"

# --- MinIO Dashboard (only needed if self-hosting MinIO instead of R2) ---
MINIO_ROOT_USER="your_minio_admin_username"
MINIO_ROOT_PASSWORD="your_minio_admin_password_should_be_long"

# --- Cloudflare R2 Uploads (for website CMS hero/attraction images) ---
# Same credentials as VAULT above — both point to the same R2 bucket
# Get API tokens from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="crm-backups"
R2_PUBLIC_URL="https://media.imagicaholidays.com"

# --- n8n Integration ---
N8N_ENCRYPTION_KEY="your_secure_n8n_encryption_key"

# --- Razorpay Integration ---
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# --- Cloudinary Settings ---
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# --- WhatsApp / Interakt ---
INTERAKT_API_KEY="your_interakt_whatsapp_key"
WEBHOOK_API_KEY="your_internal_webhook_key"
COMPANY_NAME="Imagicaholidays"
# WhatsApp send mode: 'manual' = CRM user sends manually, 'auto' = auto-send on events
WHATSAPP_MODE="manual"

# --- Google Ads Enhanced Conversions for Leads ---
GOOGLE_ADS_CUSTOMER_ID="YOUR_CUSTOMER_ID_HERE"
GOOGLE_ADS_DEVELOPER_TOKEN="YOUR_DEVELOPER_TOKEN_HERE"
GOOGLE_ADS_ACCESS_TOKEN="YOUR_ACCESS_TOKEN_HERE"
GOOGLE_ADS_REFRESH_TOKEN="YOUR_REFRESH_TOKEN_HERE"
GOOGLE_ADS_CLIENT_ID="YOUR_CLIENT_ID_HERE"
GOOGLE_ADS_CLIENT_SECRET="YOUR_CLIENT_SECRET_HERE"
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_API_VERSION="v17"
GOOGLE_ADS_CONVERSION_ACTION_LEAD="YOUR_CONVERSION_ACTION_ID_LEAD"
GOOGLE_ADS_CONVERSION_ACTION_QUALIFIED="YOUR_CONVERSION_ACTION_ID_QUALIFIED"
GOOGLE_ADS_CONVERSION_ACTION_CONVERTED="YOUR_CONVERSION_ACTION_ID_CONVERTED"

# --- Meta Conversions API (CAPI) ---
META_PIXEL_ID="YOUR_META_PIXEL_ID_HERE"
META_ACCESS_TOKEN="YOUR_META_ACCESS_TOKEN_HERE"
META_API_VERSION="v24.0"
META_TEST_EVENT_CODE="TEST_EVENT_CODE_IF_ANY"

