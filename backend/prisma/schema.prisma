// ============================================================
// TravelCRM — Prisma Schema
// 14 Core Tables + 4 RBAC Tables + 1 Audit Trail Table
// ============================================================
// This file is the SINGLE SOURCE OF TRUTH for the database.
// Run `npx prisma migrate dev` to apply changes.
// Run `npx prisma generate` to regenerate the client.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. ROLES & PERMISSIONS (RBAC)
// ============================================================

/// System roles: admin, sales_manager, sales_exec, ops, accounts, field_agent
model Role {
  id          String   @id @default(uuid())
  name        String   @unique /// e.g. 'admin', 'sales_manager'
  label       String /// Display name e.g. 'Sales Executive'
  description String?
  isSystem    Boolean  @default(true) /// System roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// All granular permission keys like 'query.view_all', 'payment.delete'
model Permission {
  id          String  @id @default(uuid())
  key         String  @unique /// e.g. 'query.view_all'
  label       String /// Human readable: 'View all team leads'
  module      String /// 'queries','notes','proposals','tours','payments','reports','masters','users'
  description String?

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@map("permissions")
}

/// Mapping: which permissions are granted by default to each role
model RolePermission {
  id           String  @id @default(uuid())
  roleId       String  @map("role_id")
  permissionId String  @map("permission_id")
  granted      Boolean @default(false)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-person permission overrides set by Admin
model UserPermissionOverride {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  permissionId String   @map("permission_id")
  granted      Boolean /// true = GRANT override, false = REVOKE override
  reason       String? /// Optional note by Admin
  setBy        String   @map("set_by")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  setByUser  User       @relation("OverrideSetBy", fields: [setBy], references: [id])

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

// ============================================================
// 2. USERS
// ============================================================

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  roleId         String    @map("role_id")
  isActive       Boolean   @default(true) @map("is_active")
  mobileOnly     Boolean   @default(false) @map("mobile_only") /// true = Field Agent, PWA only
  isOnLeave      Boolean   @default(false) @map("is_on_leave")
  leaveUntil     DateTime? @map("leave_until")
  maxLeads       Int       @default(50) @map("max_leads") /// Workload cap for assignment
  lastAssignedAt DateTime? @map("last_assigned_at") /// Round-robin tracking
  branchId       String?   @map("branch_id")
  mobile         String?
  mobile2        String?
  profilePhoto   String?   @map("profile_photo")
  department     String? /// 'Sales', 'Finance', 'Ops'
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  role                Role                     @relation(fields: [roleId], references: [id])
  createdByUser       User?                    @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers        User[]                   @relation("UserCreatedBy")
  permissionOverrides UserPermissionOverride[] @relation("UserOverrides")
  overridesSetByMe    UserPermissionOverride[] @relation("OverrideSetBy")

  branch                 Branch?            @relation("UserBranch", fields: [branchId], references: [id])

  // Relations to business entities
  assignedQueries        Query[]            @relation("QueryAssignedTo")
  queryNotes             QueryNote[]
  proposals              Proposal[]
  assignedTours          Tour[]             @relation("TourAssignedOps")
  recordedPayments       Payment[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  userSessions           UserSession[]
  requestedCancellations TourCancellation[] @relation("CancellationRequestedBy")
  processedCancellations TourCancellation[] @relation("CancellationProcessedBy")
  emailLogs              EmailLog[]
  expenses               Expense[]          @relation("ExpenseRecordedBy")
  invoices               Invoice[]          @relation("InvoiceCreatedBy")
  vendorPayments         VendorPayment[]    @relation("VendorPaymentRecordedBy")
  bookingServices        BookingService[]   @relation("BookingServiceCreatedBy")
  vouchers               Voucher[]          @relation("VoucherCreatedBy")
  uploadedDocuments      QueryDocument[]    @relation("DocumentUploadedBy")
  itineraries            Itinerary[]        @relation("ItineraryCreatedBy")

  twoFactorCode      String?   @map("two_factor_code")
  twoFactorExpires   DateTime? @map("two_factor_expires")
  twoFactorSessionId String?   @map("two_factor_session_id")

  @@index([roleId])
  @@index([isActive])
  @@index([lastAssignedAt])
  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  deviceInfo       String?  @map("device_info")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ============================================================
// 3. QUERIES (LEADS)
// ============================================================

model Query {
  id             String    @id @default(uuid())
  queryCode      String    @unique @map("query_code") /// e.g. QRY-2024-001
  version        Int       @default(1) /// Optimistic locking
  name           String /// Customer full name
  phone          String /// Primary contact
  email          String?
  destination    String? /// Travel destination(s)
  travelDateFrom DateTime? @map("travel_date_from") @db.Date
  travelDateTo   DateTime? @map("travel_date_to") @db.Date
  adults         Int       @default(1)
  children       Int       @default(0)
  budget         Decimal?  @db.Decimal(12, 2)
  leadSource     String    @map("lead_source") /// 'website','call','walkin','whatsapp','facebook','google','reference','agent'
  campaignName   String?   @map("campaign_name")
  status         String    @default("new") /// 'new','quoted','negotiation','confirmed','in_progress','completed','lost','invalid'
  assignedTo     String?   @map("assigned_to")
  nextFollowupAt DateTime? @map("next_followup_at")
  mergedInto     String?   @map("merged_into") /// If this query was merged into another
  clientId       String?   @map("client_id")
  b2bAgentId     String?   @map("b2b_agent_id")
  deletedAt      DateTime? @map("deleted_at") /// Soft delete
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  assignedUser User?       @relation("QueryAssignedTo", fields: [assignedTo], references: [id])
  client       Client?     @relation(fields: [clientId], references: [id])
  b2bAgent     B2BAgent?   @relation(fields: [b2bAgentId], references: [id])
  notes        QueryNote[]
  proposals    Proposal[]
  tours           Tour[]
  payments        Payment[]
  emailLogs       EmailLog[]
  bookingServices BookingService[]
  vouchers        Voucher[]
  documents       QueryDocument[]
  vendorPayments  VendorPayment[]

  @@index([phone]) // Duplicate check
  @@index([assignedTo]) // My leads filter
  @@index([status]) // Pipeline queries
  @@index([nextFollowupAt]) // Overdue cron query
  @@index([leadSource]) // Marketing ROI reporting
  @@index([createdAt]) // Date-range filtering
  @@index([assignedTo, status]) // Agent + status composite
  @@index([deletedAt]) // Soft-delete filter
  @@map("queries")
}

// ============================================================
// 4. QUERY NOTES & FOLLOW-UPS
// ============================================================

model QueryNote {
  id         String    @id @default(uuid())
  queryId    String    @map("query_id")
  userId     String    @map("user_id")
  note       String
  noteType   String    @default("note") @map("note_type") /// 'note', 'followup', 'call_log'
  followUpAt DateTime? @map("follow_up_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  query Query @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([queryId])
  @@index([userId])
  @@index([followUpAt])
  @@map("query_notes")
}

// ============================================================
// 5. MASTER TABLES (Destinations & Hotels)
// ============================================================

model Destination {
  id          String  @id @default(uuid())
  name        String /// e.g. Goa, Manali, Bali
  country     String?
  description String?
  isActive    Boolean @default(true) @map("is_active")

  hotels         Hotel[]
  proposalDays   ProposalDay[]
  activities     Activity[]
  transfers      Transfer[]
  dayTemplates   DayItineraryTemplate[]
  destinationCms DestinationCms?
  itineraryDays  ItineraryDay[]

  @@map("destinations")
}

model Hotel {
  id            String   @id @default(uuid())
  destinationId String   @map("destination_id")
  name          String
  category      String? /// '3*','4*','5*','Budget'
  basePrice     Decimal? @map("base_price") @db.Decimal(10, 2) /// Cost price per night
  imageUrl      String?  @map("image_url")
  isActive      Boolean  @default(true) @map("is_active")

  destination  Destination   @relation(fields: [destinationId], references: [id])
  proposalDays ProposalDay[]

  @@index([destinationId])
  @@map("hotels")
}

// ============================================================
// 6. PROPOSALS & ITINERARIES
// ============================================================

model Proposal {
  id           String    @id @default(uuid())
  queryId      String    @map("query_id")
  itineraryId  String?   @map("itinerary_id")
  version      Int       @default(1)
  status       String    @default("pending") @map("status") /// 'pending', 'confirmed', 'rejected'
  totalCost      Decimal?  @map("total_cost") @db.Decimal(12, 2)
  markupPct      Decimal?  @map("markup_pct") @db.Decimal(5, 2)
  sellingPrice   Decimal?  @map("selling_price") @db.Decimal(12, 2)
  travelDateFrom DateTime? @map("travel_date_from") @db.Date
  travelDateTo   DateTime? @map("travel_date_to") @db.Date
  pdfUrl       String?   @map("pdf_url")
  pdfStatus    String    @default("none") @map("pdf_status") /// 'none','pending','ready','failed'
  sentAt       DateTime? @map("sent_at")
  lastSentAt   DateTime? @map("last_sent_at") /// Cooldown tracking to prevent duplicate sends
  createdBy    String    @map("created_by")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  query     Query      @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [createdBy], references: [id])
  itinerary Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  days      ProposalDay[]
  tours     Tour[]

  @@index([queryId])
  @@index([itineraryId])
  @@map("proposals")
}

model ProposalDay {
  id            String   @id @default(uuid())
  proposalId    String   @map("proposal_id")
  dayNumber     Int      @map("day_number")
  destinationId String?  @map("destination_id")
  hotelId       String?  @map("hotel_id")
  activities    String?
  description   String?  @db.Text
  mealsIncluded String?  @map("meals_included") /// 'BB','HB','FB','AI'
  transport     String?
  dayCost       Decimal? @map("day_cost") @db.Decimal(10, 2)

  proposal    Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id])
  hotel       Hotel?       @relation(fields: [hotelId], references: [id])
  bookingServices BookingService[]

  @@index([proposalId])
  @@map("proposal_days")
}

// ============================================================
// 7. TOURS
// ============================================================

model Tour {
  id          String    @id @default(uuid())
  queryId     String    @map("query_id")
  proposalId  String?   @map("proposal_id")
  tourCode    String    @unique @map("tour_code") /// e.g. TUR-2024-001
  status      String    @default("upcoming") /// 'upcoming','running','completed','cancelled'
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  totalPax    Int?      @map("total_pax")
  opsNotes    String?   @map("ops_notes")
  assignedOps String?   @map("assigned_ops")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  query           Query             @relation(fields: [queryId], references: [id])
  proposal        Proposal?         @relation(fields: [proposalId], references: [id])
  assignedOpsUser User?             @relation("TourAssignedOps", fields: [assignedOps], references: [id])
  payments        Payment[]
  cancellation    TourCancellation?

  @@index([status])
  @@index([startDate])
  @@index([assignedOps])
  @@map("tours")
}

model TourCancellation {
  id           String   @id @default(uuid())
  tourId       String   @unique @map("tour_id")
  reason       String
  refundAmount Decimal? @map("refund_amount") @db.Decimal(12, 2)
  status       String   @default("pending") /// 'pending', 'approved', 'refunded'
  requestedBy  String   @map("requested_by")
  processedBy  String?  @map("processed_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tour        Tour  @relation(fields: [tourId], references: [id])
  requestUser User  @relation("CancellationRequestedBy", fields: [requestedBy], references: [id])
  processUser User? @relation("CancellationProcessedBy", fields: [processedBy], references: [id])

  @@map("tour_cancellations")
}

// ============================================================
// 8. PAYMENTS
// ============================================================

model Payment {
  id             String    @id @default(uuid())
  tourId         String?   @map("tour_id")
  queryId        String?   @map("query_id")
  amount         Decimal   @db.Decimal(12, 2)
  mode           String /// 'upi','neft','card','cash','cheque'
  referenceUtr   String?   @map("reference_utr")
  paymentDate    DateTime  @map("payment_date") @db.Date
  recordedBy     String?   @map("recorded_by")
  status         String    @default("pending") /// 'pending','verified','banked'
  notes          String?
  idempotencyKey String?   @unique @map("idempotency_key") /// Prevents duplicate webhook payments
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tour  Tour?  @relation(fields: [tourId], references: [id])
  query Query? @relation(fields: [queryId], references: [id])
  user  User?  @relation(fields: [recordedBy], references: [id])

  @@index([tourId])
  @@index([queryId])
  @@index([status])
  @@index([paymentDate])
  @@map("payments")
}

// ============================================================
// 9. NOTIFICATIONS
// ============================================================

model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String /// 'followup_due','payment_overdue','tour_starting'
  message     String
  channel     String    @default("in_app") /// 'in_app','email','whatsapp'
  priority    String    @default("normal") /// 'low','normal','high','urgent'
  relatedType String?   @map("related_type") /// 'query','tour','payment'
  relatedId   String?   @map("related_id") /// query_id / tour_id etc.
  isRead      Boolean   @default(false) @map("is_read")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// 10. ACTIVITY LOG (Audit Trail)
// ============================================================

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String /// e.g. 'query.status_changed', 'payment.deleted'
  entityType String   @map("entity_type") /// 'query','tour','payment','user'
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model IntegrationLog {
  id           String   @id @default(uuid())
  type         String /// 'whatsapp', 'email', 'razorpay'
  direction    String /// 'inbound', 'outbound'
  status       String /// 'success', 'failed', 'pending'
  payload      Json?
  errorMessage String?  @map("error_message")
  relatedId    String?  @map("related_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([type, status])
  @@index([relatedId])
  @@map("integration_logs")
}

// ============================================================
// 11. SPRINT 7 MODELS (Clients, Agents, Email, Settings, Masters)
// ============================================================

model Client {
  id             String    @id @default(uuid())
  name           String
  phone          String    @unique
  email          String?
  whatsapp       String?
  mobile2        String?
  address        String?
  city           String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  anniversary    DateTime? @db.Date
  passportNumber String?   @map("passport_number")
  passportExpiry DateTime? @map("passport_expiry") @db.Date
  lifetimeSpend  Decimal   @default(0) @map("lifetime_spend") @db.Decimal(12, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  queries Query[]

  @@map("clients")
}

model B2BAgent {
  id          String    @id @default(uuid())
  companyName String    @map("company_name")
  gstNumber   String?   @map("gst_number")
  mobile      String    @unique
  mobile2     String?
  email       String?
  email2      String?
  city        String?
  address     String?
  dob         DateTime? @db.Date
  anniversary DateTime? @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  queries Query[]

  @@map("b2b_agents")
}

model EmailTemplate {
  id           String   @id @default(uuid())
  name         String
  subject      String
  bodyRichText String   @map("body_rich_text") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  emailLogs    EmailLog[]

  @@map("email_templates")
}

model QueryStatusSetting {
  id                 String  @id @default(uuid())
  code               String  @unique /// e.g. 'new', 'confirmed'
  label              String
  colorHex           String  @default("#6B7280") @map("color_hex")
  isDashboardVisible Boolean @default(true) @map("is_dashboard_visible")
  isLocked           Boolean @default(false) @map("is_locked")
  takeNoteFlag       Boolean @default(false) @map("take_note_flag")
  sequence           Int     @default(0)
  isActive           Boolean @default(true) @map("is_active")

  @@map("query_status_settings")
}

model OrgSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("org_settings")
}

model Supplier {
  id            String  @id @default(uuid())
  companyName   String? @map("company_name")
  category      String?
  contactPerson String? @map("contact_person")
  email         String?
  phone         String?
  city          String?
  address       String?
  isActive      Boolean @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")

  bookingServices BookingService[]

  @@map("suppliers")
}

model Activity {
  id             String  @id @default(uuid())
  name           String
  destinationId  String  @map("destination_id")
  pricePerPerson Decimal @map("price_per_person") @db.Decimal(10, 2)
  photoUrl       String? @map("photo_url")
  description    String? @db.Text
  isActive       Boolean @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")

  destination Destination @relation(fields: [destinationId], references: [id])

  @@map("activities")
}

model Transfer {
  id            String  @id @default(uuid())
  vehicleType   String  @map("vehicle_type")
  destinationId String  @map("destination_id")
  price         Decimal? @db.Decimal(10, 2)
  photoUrl      String? @map("photo_url")
  description   String?
  isActive      Boolean @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")

  destination Destination @relation(fields: [destinationId], references: [id])

  @@map("transfers")
}

model RoomType {
  id       String  @id @default(uuid())
  name     String /// e.g. Single, Double, Triple
  isActive Boolean @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  @@map("room_types")
}

model MealPlan {
  id       String  @id @default(uuid())
  name     String /// e.g. BB, HB, FB, AI
  price    Decimal @default(0) @db.Decimal(10, 2)
  isActive Boolean @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  @@map("meal_plans")
}

model PackageTheme {
  id       String  @id @default(uuid())
  name     String /// e.g. Adventure, Honeymoon
  isActive Boolean @default(true) @map("is_active")
  iconUrl  String? @map("icon_url")
  deletedAt DateTime? @map("deleted_at")

  @@map("package_themes")
}

model DayItineraryTemplate {
  id            String   @id @default(uuid())
  title         String
  destinationId String   @map("destination_id")
  description   String?  @db.Text
  photoUrl      String?  @map("photo_url")
  isActive      Boolean  @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")

  destination Destination @relation(fields: [destinationId], references: [id])

  @@map("day_itinerary_templates")
}

model EmailLog {
  id                String   @id @default(uuid())
  queryId           String   @map("query_id")
  templateId        String?  @map("template_id")
  to                String?
  cc                String?
  subject           String
  body              String   @db.Text
  sentBy            String?  @map("sent_by")
  sentAt            DateTime @default(now()) @map("sent_at")
  status            String   @default("sent") /// 'sent', 'failed'
  errorMessage      String?  @map("error_msg")
  communicationType String   @default("customer") @map("communication_type") /// 'customer', 'supplier'

  query    Query          @relation(fields: [queryId], references: [id])
  template EmailTemplate? @relation(fields: [templateId], references: [id])
  sender   User?          @relation(fields: [sentBy], references: [id])

  @@index([queryId])
  @@map("email_logs")
}

// ============================================================
// 12. SPRINT 8 — WEBSITE CMS MODELS
// ============================================================

/// CMS pages: About Us, Terms, Privacy, etc.
model CmsPage {
  id          String   @id @default(uuid())
  slug        String   @unique /// e.g. 'about', 'terms', 'privacy'
  title       String
  bodyHtml    String   @map("body_html") @db.Text
  seoTitle    String?  @map("seo_title")
  seoDesc     String?  @map("seo_desc")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

/// Homepage hero banners
model HomeBanner {
  id       String  @id @default(uuid())
  imageUrl String  @map("image_url")
  title    String?
  subtitle String?
  linkUrl  String? @map("link_url")
  sequence Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  @@map("home_banners")
}

/// Customer testimonials
model Testimonial {
  id           String  @id @default(uuid())
  customerName String  @map("customer_name")
  rating       Int     @default(5) /// 1-5 stars
  text         String  @db.Text
  photoUrl     String? @map("photo_url")
  destination  String? /// e.g. 'Sikkim Trip'
  isActive     Boolean @default(true) @map("is_active")

  @@map("testimonials")
}

/// Photo gallery entries
model GalleryImage {
  id       String  @id @default(uuid())
  imageUrl String  @map("image_url")
  caption  String?
  category String? /// e.g. 'Sikkim', 'Darjeeling', 'Adventure'
  sequence Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  @@map("gallery_images")
}

/// Blog / SEO posts
model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  bodyHtml    String    @map("body_html") @db.Text
  excerpt     String?   @db.Text
  coverImage  String?   @map("cover_image")
  author      String?
  tags        String?   /// comma-separated tags
  seoTitle    String?   @map("seo_title")
  seoDesc     String?   @map("seo_desc")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

/// Extended destination info for public site
model DestinationCms {
  id            String  @id @default(uuid())
  destinationId String  @unique @map("destination_id")
  aboutHtml     String? @map("about_html") @db.Text
  heroImage     String? @map("hero_image")
  galleryImages Json?   @map("gallery_images") /// JSON array of image URLs
  seoTitle      String? @map("seo_title")
  seoDesc       String? @map("seo_desc")
  isPublished   Boolean @default(false) @map("is_published")

  destination Destination @relation(fields: [destinationId], references: [id])

  @@map("destination_cms")
}

/// Reusable package terms & conditions templates
model PackageTerms {
  id        String   @id @default(uuid())
  name      String /// e.g. 'Standard T&C', 'Adventure T&C'
  bodyHtml  String   @map("body_html") @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("package_terms")
}

// ============================================================
// 13. SPRINT 8 — FINANCE / EXPENSE BOOK MODELS
// ============================================================

/// Business expense records
model Expense {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  category    String   /// 'travel', 'office', 'salary', 'marketing', 'vendor', 'misc'
  vendor      String?  /// who was paid
  description String?
  expenseDate DateTime @map("expense_date") @db.Date
  receiptUrl  String?  @map("receipt_url")
  recordedBy  String   @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation("ExpenseRecordedBy", fields: [recordedBy], references: [id])

  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

/// Client invoices
model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique @map("invoice_number") /// e.g. INV-2026-001
  queryId       String?   @map("query_id")
  tourId        String?   @map("tour_id")
  clientName    String    @map("client_name")
  clientEmail   String?   @map("client_email")
  clientPhone   String?   @map("client_phone")
  clientAddress String?   @map("client_address")
  items         Json      /// JSON array: [{description, qty, rate, amount}]
  subtotal      Decimal   @db.Decimal(12, 2)
  taxPercent    Decimal   @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount     Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal   @map("total_amount") @db.Decimal(12, 2)
  pdfUrl        String?   @map("pdf_url")
  status        String    @default("draft") /// 'draft', 'sent', 'paid', 'cancelled'
  sentAt        DateTime? @map("sent_at")
  paidAt        DateTime? @map("paid_at")
  dueDate       DateTime? @map("due_date") @db.Date
  notes         String?   @db.Text
  createdBy     String    @map("created_by")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  creator User @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

/// Vendor / supplier payment tracking
model VendorPayment {
  id          String   @id @default(uuid())
  supplierId  String?  @map("supplier_id")
  queryId     String?  @map("query_id")
  vendorName  String   @map("vendor_name")
  amount      Decimal  @db.Decimal(12, 2)
  mode        String   /// 'upi', 'neft', 'cash', 'cheque'
  referenceId String?  @map("reference_id")
  paymentDate DateTime @map("payment_date") @db.Date
  tourId      String?  @map("tour_id")
  notes       String?
  recordedBy  String   @map("recorded_by")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User   @relation("VendorPaymentRecordedBy", fields: [recordedBy], references: [id])
  query Query? @relation(fields: [queryId], references: [id])

  @@index([paymentDate])
  @@index([supplierId])
  @@index([queryId])
  @@map("vendor_payments")
}

// ============================================================
// 14. SPRINT 8 — GOOGLE SHEETS LEAD SYNC
// ============================================================

model SheetSyncConfig {
  id            String    @id @default(uuid())
  name          String    /// 'Facebook Leads Sheet', 'Website Form Sheet'
  sheetUrl      String    @map("sheet_url")
  sheetId       String    @map("sheet_id")
  tabName       String    @default("Sheet1") @map("tab_name")
  columnMapping Json      @map("column_mapping") /// {name: 'A', phone: 'B', email: 'C', ...}
  lastSyncAt    DateTime? @map("last_sync_at")
  syncInterval  Int       @default(60) @map("sync_interval") /// minutes
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("sheet_sync_configs")
}

// ============================================================
// 15. SPRINT 8 — BRANCH MANAGEMENT
// ============================================================

model Branch {
  id       String  @id @default(uuid())
  name     String  @unique /// e.g. 'Gangtok HQ', 'Darjeeling Office'
  city     String?
  address  String?
  phone    String?
  isActive Boolean @default(true) @map("is_active")

  users User[] @relation("UserBranch")

  @@map("branches")
}

// ============================================================
// 16. SPRINT 10 — POST SALES, VOUCHERS, DOCUMENTS
// ============================================================

/// Booking services auto-generated from confirmed proposals
model BookingService {
  id                   String    @id @default(uuid())
  queryId              String    @map("query_id")
  proposalDayId        String?   @map("proposal_day_id")
  serviceType          String    @map("service_type") /// 'hotel', 'transport'
  serviceName          String    @map("service_name")
  supplierId           String?   @map("supplier_id")
  supplierName         String?   @map("supplier_name")
  supplierEmail        String?   @map("supplier_email")
  checkIn              DateTime? @map("check_in") @db.Date
  checkOut             DateTime? @map("check_out") @db.Date
  serviceDate          DateTime? @map("service_date") @db.Date
  ratePerUnit          Decimal   @default(0) @map("rate_per_unit") @db.Decimal(12, 2)
  units                Int       @default(1)
  totalCost            Decimal   @default(0) @map("total_cost") @db.Decimal(12, 2)
  supplierAmountPaid   Decimal   @default(0) @map("supplier_amount_paid") @db.Decimal(12, 2)
  supplierAmountPending Decimal  @default(0) @map("supplier_amount_pending") @db.Decimal(12, 2)
  mailStatus           String    @default("not_sent") @map("mail_status") /// 'not_sent', 'sent', 'read'
  mailSentAt           DateTime? @map("mail_sent_at")
  paymentStatus        String    @default("pending") @map("payment_status") /// 'pending', 'partial', 'paid'
  confirmationNumber   String?   @map("confirmation_number")
  notes                String?   @db.Text
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  query       Query        @relation(fields: [queryId], references: [id], onDelete: Cascade)
  proposalDay ProposalDay? @relation(fields: [proposalDayId], references: [id])
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  creator     User         @relation("BookingServiceCreatedBy", fields: [createdBy], references: [id])
  vouchers    Voucher[]

  @@index([queryId])
  @@index([serviceType])
  @@map("booking_services")
}

/// Customer and supplier vouchers
model Voucher {
  id                 String    @id @default(uuid())
  queryId            String    @map("query_id")
  bookingServiceId   String?   @map("booking_service_id")
  voucherType        String    @map("voucher_type") /// 'customer', 'supplier'
  voucherNumber      String    @unique @map("voucher_number") /// e.g. VCH-2026-001
  confirmationNumber String?   @map("confirmation_number")
  supplierName       String?   @map("supplier_name")
  hotelName          String?   @map("hotel_name")
  destination        String?
  leadPaxName        String?   @map("lead_pax_name")
  paxDetails         String?   @map("pax_details") /// '2 Adults, 1 Child'
  checkIn            DateTime? @map("check_in") @db.Date
  checkOut           DateTime? @map("check_out") @db.Date
  checkInTime        String?   @map("check_in_time")
  checkOutTime       String?   @map("check_out_time")
  roomType           String?   @map("room_type")
  mealPlan           String?   @map("meal_plan")
  greetingMessage    String?   @map("greeting_message") @db.Text
  pdfUrl             String?   @map("pdf_url")
  status             String    @default("draft") /// 'draft', 'sent'
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")

  query          Query           @relation(fields: [queryId], references: [id], onDelete: Cascade)
  bookingService BookingService? @relation(fields: [bookingServiceId], references: [id])
  creator        User            @relation("VoucherCreatedBy", fields: [createdBy], references: [id])

  @@index([queryId])
  @@map("vouchers")
}

/// File uploads per query
model QueryDocument {
  id         String   @id @default(uuid())
  queryId    String   @map("query_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type") /// 'PDF', 'JPG', 'PNG', 'DOCX' etc.
  fileSize   Int      @map("file_size") /// in KB
  uploadedBy String   @map("uploaded_by")
  label      String?  /// e.g. 'Passport - Sagar Mukherjee'
  createdAt  DateTime @default(now()) @map("created_at")

  query    Query @relation(fields: [queryId], references: [id], onDelete: Cascade)
  uploader User  @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])

  @@index([queryId])
  @@map("query_documents")
}

// ============================================================
// 17. ITINERARY BUILDER SYSTEM
// ============================================================

/// Full itinerary with days, events, gallery and share capabilities
model Itinerary {
  id             String    @id @default(uuid())
  title          String
  description    String?   @db.Text
  coverPhotoUrl  String?   @map("cover_photo_url")
  shareSlug      String?   @unique @map("share_slug") /// nanoid for public share URL
  status         String    @default("draft") /// 'draft', 'published'
  totalCost      Decimal?  @map("total_cost") @db.Decimal(12, 2)
  perPersonCost  Decimal?  @map("per_person_cost") @db.Decimal(12, 2)
  costingBreakdown Json?   @map("costing_breakdown")
  sellingPrice   Decimal?  @map("selling_price") @db.Decimal(12, 2)
  currency       String    @default("INR")
  adults         Int       @default(2)
  children       Int       @default(0)
  nights         Int?      @map("nights")
  travelDateFrom DateTime? @map("travel_date_from") @db.Date
  travelDateTo   DateTime? @map("travel_date_to") @db.Date
  markupPct      Decimal?  @map("markup_pct") @db.Decimal(5, 2)
  inclusionsHtml         String?   @map("inclusions_html") @db.Text
  exclusionsHtml         String?   @map("exclusions_html") @db.Text
  paymentPolicyHtml      String?   @map("payment_policy_html") @db.Text
  cancellationPolicyHtml String?   @map("cancellation_policy_html") @db.Text
  termsHtml              String?   @map("terms_html") @db.Text
  createdBy      String    @map("created_by")
  isTemplate     Boolean   @default(false) @map("is_template")
  sourceTemplateId String? @map("source_template_id")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  creator       User                    @relation("ItineraryCreatedBy", fields: [createdBy], references: [id])
  days          ItineraryDay[]
  galleryImages ItineraryGalleryImage[]
  proposals     Proposal[]

  @@index([createdBy])
  @@index([status])
  @@index([isTemplate])
  @@index([createdAt])
  @@map("itineraries")
}

/// A single day within an itinerary
model ItineraryDay {
  id            String  @id @default(uuid())
  itineraryId   String  @map("itinerary_id")
  dayNumber     Int     @map("day_number")
  title         String? /// e.g. 'Gangtok Arrival & Local Sightseeing'
  description   String? @db.Text
  imageUrl      String? @map("image_url")
  destinationId String? @map("destination_id")

  itinerary   Itinerary        @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination Destination?     @relation(fields: [destinationId], references: [id])
  events      ItineraryEvent[]

  @@index([itineraryId])
  @@map("itinerary_days")
}

/// An event within an itinerary day (accommodation, sightseeing, transport, etc.)
model ItineraryEvent {
  id          String   @id @default(uuid())
  dayId       String   @map("day_id")
  type        String   /// 'accommodation','sightseeing','activity','transport','flight','meal','checkin','checkout','freeTime'
  title       String
  description String?  @db.Text
  startTime   String?  @map("start_time") /// e.g. '09:00'
  endTime     String?  @map("end_time")   /// e.g. '11:30'
  cost        Decimal? @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  metadata    Json?    /// Type-specific fields: hotelName, roomType, flightNumber, etc.
  sortOrder   Int      @default(0) @map("sort_order")

  day ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([type])
  @@map("itinerary_events")
}

/// Gallery images for an itinerary
model ItineraryGalleryImage {
  id          String @id @default(uuid())
  itineraryId String @map("itinerary_id")
  imageUrl    String @map("image_url")
  caption     String?
  sortOrder   Int    @default(0) @map("sort_order")

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@map("itinerary_gallery_images")
}

// ============================================================
// 18. WEBSITE CONTENT MANAGEMENT
// ============================================================

/// Journey packages displayed on the imagicaholidays website
model WebsiteJourney {
  id              String   @id @default(uuid())
  slug            String   @unique /// URL slug e.g. "sikkim-journey-0"
  title           String
  regions         String   /// e.g. "NORTH-EAST INDIA & SIKKIM"
  durationNights  Int      @map("duration_nights")
  durationDays    Int      @map("duration_days")
  pricePerGuest   Int      @map("price_per_guest")
  originalPrice   Int      @map("original_price")
  departurePort   String   @map("departure_port")
  returnPort      String   @map("return_port")
  departureDate   String   @map("departure_date") /// e.g. "1 Nov 2026"
  returnDate      String   @map("return_date")
  ports           Int      @default(2)
  countries       Int      @default(1)
  vehicle         String   @default("Premium SUV")
  badges          Json     /// JSON array e.g. ["SIKKIM"]
  images          Json     /// JSON array of image URLs
  mapImage        String?  @map("map_image")
  overview        String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  sequence        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  days WebsiteJourneyDay[]

  @@index([isActive])
  @@index([sequence])
  @@map("website_journeys")
}

/// Itinerary day within a website journey
model WebsiteJourneyDay {
  id          String  @id @default(uuid())
  journeyId   String  @map("journey_id")
  dayNumber   Int     @map("day_number")
  title       String  /// e.g. "Discover Gangtok"
  date        String  /// e.g. "1 Nov"
  time        String  /// e.g. "Arrival 12:00"
  description String? @db.Text
  image       String? /// image URL

  journey WebsiteJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@map("website_journey_days")
}

/// Trending destination items for the homepage popup on imagicaholidays
model TrendingDestination {
  id          String  @id @default(uuid())
  region      String  /// e.g. "Northern Frontiers"
  title       String  /// e.g. "Kedarnath"
  tagline     String  /// e.g. "The Sacred Spiritual Peaks"
  image       String  /// image URL
  link        String  /// e.g. "/destinations/gangtok"
  lastUpdated String  @map("last_updated") /// e.g. "April 22, 2026"
  isActive    Boolean @default(true) @map("is_active")
  sequence    Int     @default(0)

  @@index([isActive])
  @@map("trending_destinations")
}
