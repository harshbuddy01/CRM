# ============================================================
# TravelCRM — Hostinger Proxy Redirects
# ============================================================
# Ensures that Next.js routes are handled by the Node.js server.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Forward all requests to the Node.js port (usually 3000 by default in standalone)
  # But Hostinger manages this via the Port specified in the Dashboard.
  
  # Avoid looping if already routed
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://localhost:%{PORT}/$1 [P,L]
</IfModule>
